# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# Browser-facing ContribOS origin.
# Local Vite development:
CONTRIBOS_PUBLIC_BASE_URL=http://localhost:5173

# Generate a base64-encoded 32-byte key, for example:
# openssl rand -base64 32
CONTRIBOS_CREDENTIAL_ENCRYPTION_KEY=

# Optional auth lifetimes
# CONTRIBOS_SESSION_TTL_SECONDS=604800
# CONTRIBOS_OAUTH_STATE_TTL_SECONDS=600

# Control plane
CONTRIBOS_HOST=0.0.0.0
PORT=3000
# CONTRIBOS_RECONCILIATION_SWEEP_INTERVAL_MS=300000

# Database
DATABASE_URL=

# Redis
REDIS_URL=
