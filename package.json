{
  "name": "contribos",
  "version": "0.1.1",
  "private": true,
  "description": "GitHub-native contribution operations and trust layer.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
