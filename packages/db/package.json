{
  "name": "@contribos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fileParallelism=false --testTimeout=15000",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@contribos/domain": "workspace:*",
    "@contribos/github": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
